=============max-consecutive-ones

class Solution {
    public int findMaxConsecutiveOnes(int[] nums) {
        int ones=0;
        int count=0;
     for(int i =0;i<nums.length;i++){
        if(nums[i]==1){
            ones++;
            if(count<ones){
                count=ones;
            }
        }
        else{
            ones=0;
        }
     }
     return count;
    }
}

time complexity : O(n)
space complexity : O(1)
algorithm : linear traversal

