=================Second Largest
better approach:
class Solution {
    public int getSecondLargest(int[] arr) {
        // code here
        int element=-1;
        int secelement=-1;
       for(int i=0;i<arr.length;i++){
           if(arr[i]>element){
               element=arr[i];
           }
       }
       for(int i=0;i<arr.length;i++){
           if(arr[i]>secelement && arr[i]<element){
               secelement=arr[i];
           }
       }
       return secelement;
    }
}
 time complexity : O(n) + O(n) = O(2n)
space complexity : O(1)
algorithm : two traversal

brute force approach:
class Solution {
    public int getSecondLargest(int[] arr) {
        // code here
        Arrays.sort(arr);
        int seclarge = -1;
        int n=arr.length;
        for(int i=n-1;i>=0;i--){
            if(arr[i]<arr[n-1]){
                seclarge=arr[i];
                break;
            }
        }
        return seclarge;
    }
}
time complexity : O(nlogn) + O(n) = O(nlogn)
space complexity : O(logn)
algorithm : sorting + traversal

optimal approach:
class Solution {
    public int getSecondLargest(int[] arr) {
        // code here
        int large = arr[0];
        int seclarge = -1;
        int n=arr.length;
        for (int i=1;i<n;i++){
            if(arr[i]>large){
                seclarge=large;
                large=arr[i];
            }
            else if(arr[i]>seclarge && arr[i]!=large){
                seclarge=arr[i];
            }
        }
        return seclarge;
    }
}
 time complexity : O(n)
space complexity : O(1)
algorithm :traversal(one)
